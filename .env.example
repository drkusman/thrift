# Copy this file to .env (gitignored) on the EC2 instance and fill in real values before running
# docker compose up. Never commit the real .env file.

# The RDS PostgreSQL instance's own endpoint (Console -> RDS -> Databases -> your instance ->
# "Endpoint & port"), not the EC2 instance's address.
RDS_HOST=CHANGE_ME.xxxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=thrift
RDS_USERNAME=postgres
RDS_PASSWORD=CHANGE_ME

# First admin login. Change the password immediately after first sign-in in production.
THRIFT_ADMIN_REGNO=ADMIN001
THRIFT_ADMIN_PASSWORD=CHANGE_ME
